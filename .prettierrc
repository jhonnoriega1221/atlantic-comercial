{
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "none",
  "tailwindFunctions": ["hlm", "cva", "classes"],
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    }
  ],
  "plugins": ["prettier-plugin-tailwindcss"]
}
